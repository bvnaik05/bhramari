# Copy to .env and replace every change-me value before starting Compose.
POSTGRES_PASSWORD=change-me-database-password
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin-password
MINIO_ROOT_PASSWORD=change-me-minio-password
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
BHRAMARI_RELAYER_TOKEN=change-me-to-at-least-32-random-characters
# Fernet.generate_key().decode()
BHRAMARI_EVIDENCE_KEY=change-me-valid-fernet-key
# Base64 of 32 random bytes.
BHRAMARI_PASSPORT_PRIVATE_KEY=change-me-base64-ed25519-private-key
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# A real pilot requires pilot mode, a deployed multisig, and a delay of at least 86400 seconds.
DEPLOYMENT_MODE=demo
ADMIN_TRANSFER_DELAY=0
ADMIN_MULTISIG_ADDRESS=
